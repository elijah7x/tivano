    "Files go back to how they were before this turn, and the turn leaves the conversation." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les fichiers reviennent à leur état d’avant ce tour, et ce tour est retiré de la conversation."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ファイルはこのターンより前の状態に戻り、このターンはスレッドから削除されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "파일은 이 턴 이전 상태로 되돌아가며, 해당 턴은 대화에서 제거됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文件会恢复到本轮之前的状态，本轮也会从对话中移除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "檔案會恢復至本輪之前的狀態，本輪也會從對話中移除。"
          }
        }
      }
    },
    "Files go back to how they were before this turn, and this turn and anything after it leave the conversation." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les fichiers retrouvent leur état d’avant ce tour, et ce tour ainsi que la suite sont retirés de la conversation."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",

    },
    "While a turn runs, stops it and sends right away." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pendant qu’un tour est en cours, l’arrête et envoie immédiatement."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ターンの実行中、現在のターンを停止して即座に送信します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "턴이 실행되는 동안 현재 턴을 중지하고 즉시 전송합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",

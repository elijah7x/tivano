      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 已完成"
          }
        }
      }
    },
    "%@ couldn't pick this conversation back up (%@). It starts a new one here, without the messages above." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 无法恢复此对话（%@）。将在此开始新对话，不包含上面的消息。"
          }
        }
      }
    },
    "%@ declines turns until the balance is topped up." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "余额充值前，%@ 不会再处理新的轮次。"

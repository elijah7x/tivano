    "Tivano can't tell how this CLI was installed, so it won't update it." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tivano ne parvient pas à identifier comment ce CLI a été installé et ne le mettra donc pas à jour."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この CLI のインストール方法を判別できないため、Tivano は更新しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 CLI가 어떻게 설치되었는지 확인할 수 없어 Tivano가 업데이트하지 않습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法识别该 CLI 的安装方式，因此 Tivano 不会更新它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法識別此 CLI 的安裝方式，因此 Tivano 不會更新它。"
          }
        }
      }
    },
    "Tivano cannot replace itself in %@. Move it to your Applications folder and try again." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tivano ne peut pas se remplacer dans %@. Déplacez l’app dans le dossier Applications et réessayez."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tivano は %@ 内で自身を置き換えることができません。「アプリケーション」フォルダーに移動してからもう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tivano가 %@에서 자체 교체를 수행할 수 없습니다. 응용 프로그램 폴더로 이동한 후 다시 시도하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tivano 无法在 %@ 中替换自身。请将其移到“应用程序”文件夹后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tivano 無法在 %@ 中取代自身。請將其移至「應用程式」資料夾後再試一次。"
          }
        }
      }
    },
    "Tivano checks GitHub for new versions a few times a day. %@" : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tivano recherche les nouvelles versions sur GitHub plusieurs fois par jour. %@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tivano は 1 日に数回、GitHub で新しいバージョンを確認します。%@"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tivano는 하루에 몇 차례 GitHub에서 새 버전을 확인합니다. %@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tivano 每天会向 GitHub 检查几次新版本。%@"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tivano 每天會向 GitHub 檢查數次新版本。%@"
          }
        }
      }
    },
    "Tivano compares the installed version with the newest release every six hours." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tivano compare toutes les six heures la version installée avec la dernière version publiée."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tivano は 6 時間ごとにインストール済みバージョンと最新リリースを比較します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tivano는 6시간마다 설치된 버전과 최신 릴리스를 비교합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tivano 每六小时将已安装版本与最新发布版比较一次。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tivano 每六小時會將已安裝版本與最新釋出版本比較一次。"
          }
        }
      }
    },
    "Tivano could not persist the local-control operation." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tivano n’a pas pu enregistrer l’opération de contrôle local."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tivano はローカル制御操作を永続化できませんでした。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tivano가 로컬 제어 작업을 영구 저장할 수 없습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tivano 无法持久保存此本地控制操作。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tivano 無法持久儲存此本機控制操作。"
          }
        }
      }
    },
    "Tivano couldn't read %lld items in its library and loaded the rest. The original file is kept at %@ and the unreadable items at %@." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tivano n’a pas pu lire %lld éléments de sa bibliothèque et a chargé le reste. Le fichier d’origine est conservé sous %@ et les éléments illisibles sous %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tivano はライブラリ内の %lld 件の項目を読み込めなかったため、残りのみを読み込みました。元のファイルは %@ に、読み込めなかった項目は %@ に保存されています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tivano가 라이브러리에서 %lld개 항목을 읽지 못해 나머지만 불러왔습니다. 원본 파일은 %@에, 읽을 수 없는 항목은 %@에 보관되어 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tivano 无法读取资料库中的 %lld 项，已加载其余内容。原文件保存在 %@，无法读取的项目保存在 %@。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tivano 無法讀取資料庫中的 %lld 個項目，已載入其餘內容。原檔案保留於 %@，無法讀取的項目保留於 %@。"
          }
        }
      }
    },
    "Tivano couldn't read its library (%@). The original file and chat documents are preserved. Repair the library and restart Tivano. Any new chats will be saved separately to %@ when you quit." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tivano n’a pas pu lire sa bibliothèque (%@). Le fichier d’origine et les documents de conversation sont conservés. Réparez la bibliothèque et relancez Tivano. Les nouvelles conversations seront enregistrées séparément dans %@ lorsque vous quitterez l’app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tivano はライブラリ（%@）を読み込めませんでした。元のファイルとチャットドキュメントは保持されています。ライブラリを修復して Tivano を再起動してください。終了時、新しいスレッドは %@ に別途保存されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tivano가 라이브러리(%@)를 읽을 수 없습니다. 원본 파일과 대화 문서는 보존되었습니다. 라이브러리를 복구한 후 Tivano를 다시 시작하세요. 종료 시 새 대화는 %@에 별도로 저장됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tivano 无法读取资料库（%@）。原文件和对话文档已保留。请修复资料库后重启 Tivano。退出时，新建对话会另存至 %@。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tivano 無法讀取資料庫（%@）。原檔案與對話文件已保留。請修復資料庫後重新啟動 Tivano。結束程式時，新建立的對話將會另外儲存至 %@。"
          }
        }
      }
    },
    "Tivano couldn't save this chat to disk (%@). It keeps trying." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tivano n’a pas pu enregistrer cette conversation sur le disque (%@). Il continue d’essayer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tivano はこのスレッドをディスクに保存できませんでした（%@）。引き続き再試行します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tivano가 이 대화를 디스크에 저장할 수 없습니다(%@). 계속 다시 시도합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tivano 无法将此对话保存到磁盘（%@）。将继续重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tivano 無法將此對話儲存至磁碟（%@）。系統會持續重試。"
          }
        }
      }
    },
    "Tivano couldn't save your changes to disk. Your chats are kept in memory and saving will be retried. Free up disk space or check folder permissions before quitting." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tivano n’a pas pu enregistrer vos modifications sur le disque. Vos conversations restent en mémoire et l’enregistrement sera réessayé. Libérez de l’espace disque ou vérifiez les autorisations du dossier avant de quitter."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tivano は変更をディスクに保存できませんでした。スレッドはメモリ上に保持されており、保存は再試行されます。終了する前にディスクの空き容量を確保するか、フォルダーのアクセス権を確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tivano가 변경 사항을 디스크에 저장할 수 없습니다. 대화는 메모리에 유지되며 저장을 계속 다시 시도합니다. 종료하기 전에 디스크 공간을 확보하거나 폴더 권한을 확인하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tivano 无法将更改保存到磁盘。对话仍保留在内存中，保存会继续重试。退出前请释放磁盘空间或检查文件夹权限。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tivano 無法將變更儲存至磁碟。對話仍保留在記憶體中，系統會繼續重試儲存。結束程式前，請釋放磁碟空間或檢查資料夾權限。"
          }
        }
      }
    },
    "Tivano couldn't save your chats. The update was not installed. Resolve the disk error and try again." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tivano n’a pas pu enregistrer vos conversations. La mise à jour n’a pas été installée. Résolvez l’erreur disque puis réessayez."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tivano はスレッドを保存できなかったため、アップデートはインストールされませんでした。ディスクエラーを解決してからもう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tivano가 대화를 저장할 수 없어 업데이트가 설치되지 않았습니다. 디스크 오류를 해결한 후 다시 시도하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tivano 无法保存对话，更新尚未安装。请解决磁盘错误后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tivano 無法儲存對話，更新尚未安裝。請解決磁碟錯誤後再試一次。"
          }
        }
      }
    },
    "Tivano data" : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Données Tivano"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tivano のデータ"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tivano 데이터"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tivano 数据"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tivano 資料"
          }
        }
      }
    },
    "Tivano does not collect token usage itself. It shows the history that Token Taken, a companion app, collects from your AI coding tools on this Mac. Nothing leaves your computer." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tivano ne collecte pas lui-même l’utilisation des tokens. Il affiche l’historique que l’app compagnon Token Taken recueille auprès de vos outils de programmation IA sur ce Mac. Rien ne quitte votre ordinateur."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tivano 自体は token 使用量を収集しません。コンパニオンアプリである Token Taken がこの Mac 上の AI コーディングツールから収集した履歴を表示します。データが外部に送信されることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tivano는 token 사용량을 직접 수집하지 않습니다. 동반 앱인 Token Taken이 이 Mac의 AI 코딩 도구에서 수집한 기록을 표시할 뿐이며, 어떤 데이터도 컴퓨터 밖으로 나가지 않습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tivano 本身不收集 Token 用量，而是展示配套应用 Token Taken 从这台 Mac 上的 AI 编程工具收集的历史记录。所有数据均保留在你的电脑上。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tivano 本身不會收集 Token 用量，而是顯示配套應用程式 Token Taken 從這部 Mac 上的 AI 程式開發工具所收集的歷史紀錄。所有資料皆保留在你的電腦上。"
          }
        }
      }
    },
    "Tivano has not asked GitHub for a release yet" : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tivano n’a pas encore interrogé GitHub pour une version"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tivano はまだ GitHub にリリースを確認していません"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tivano가 아직 GitHub에서 릴리스를 확인하지 않았습니다"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tivano 尚未向 GitHub 查询过新版本"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tivano 尚未向 GitHub 查詢過新版本"
          }
        }
      }
    },
    "Tivano inherits this DeepSeek Harness profile read-only. Change installed plugins, bundle selections and version exemptions in DeepSeek Harness, then restart this session." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tivano hérite de ce profil DeepSeek Harness en lecture seule. Modifiez les plugins installés, les sélections de bundles et les exemptions de version dans DeepSeek Harness, puis relancez cette session."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tivano はこの DeepSeek Harness プロファイルを読み取り専用で継承します。インストール済みプラグイン、バンドル選択、バージョン除外の設定は DeepSeek Harness で変更したうえで、このセッションを再起動してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tivano는 이 DeepSeek Harness 프로필을 읽기 전용으로 상속합니다. 설치된 플러그인, 번들 선택 및 버전 예외 설정은 DeepSeek Harness에서 변경한 후 이 세션을 다시 시작하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tivano 以只读方式继承此 DeepSeek Harness profile。请在 DeepSeek Harness 中修改已安装的插件、bundle 选择和版本豁免，然后重新启动此会话。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tivano 以唯讀方式繼承此 DeepSeek Harness 設定檔。請在 DeepSeek Harness 中修改已安裝的外掛程式、bundle 選擇與版本豁免，然後重新啟動此工作階段。"
          }
        }

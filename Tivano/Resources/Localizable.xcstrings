          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tivano의 MiniMax Code는 현재 텍스트 입력만 사용합니다. 이미지 첨부, 요금제 잔액 및 token 사용량 집계는 활성화되지 않았습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MiniMax Code 目前在 Tivano 中使用文本输入，暂未启用图片附件、套餐余额和 token 消耗统计。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {

        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法讀取此對話的歷史紀錄。Tivano 已將檔案保留於 %@。"
          }
        }
      }
    },
    "This chat's working folder is unavailable." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",

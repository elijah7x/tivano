    "%@ worked in place in %@. The diff of its listed files against the copies taken before it started is above; the originals are at %@. Restore any file from there if the change is wrong." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ a travaillé directement dans %@. Le diff des fichiers listés par rapport aux copies prises avant le démarrage figure ci-dessus ; les originaux se trouvent dans %@. Restaurez-y tout fichier si une modification est incorrecte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ は %@ 内で直接ファイルを編集しました。リストされたファイルと開始前のバックアップとの差分を上に表示しています。元のファイルは %@ にあります。変更に問題がある場合はそこから復元してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 작업이 %@ 경로에서 직접 수행되었습니다. 위에 표시된 내용은 작업 시작 전 백업본과 변경된 파일 목록의 차이입니다. 원본 파일은 %@ 경로에 있으며, 변경 내용에 문제가 있으면 여기에서 복원할 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 直接在 %2$@ 中改动文件。上面是它列出的文件与开工前所取副本的差异；原件位于 %3$@。如果改动有问题，可以从那里恢复任意文件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 直接在 %@ 中修改了檔案。上方顯示的是所列檔案與開始前所保留副本的差異；原始檔案位於 %@。若修改有誤，可從該處還原任何檔案。"
          }
        }
      }
    },

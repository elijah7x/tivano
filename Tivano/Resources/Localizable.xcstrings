    "Shelve a project after its latest thread has been idle this long. Projects with running, unread or open threads stay put." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Met un projet de côté lorsque sa dernière conversation reste inactive pendant cette durée. Les projets ayant des conversations actives, non lues ou ouvertes restent en place."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最新のスレッドがこの期間アイドル状態になるとプロジェクトを保留にします。実行中、未読、または開いているスレッドがあるプロジェクトはそのまま維持されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가장 최근 스레드가 이 기간 동안 유휴 상태이면 프로젝트를 보류합니다. 실행 중이거나 읽지 않았거나 열려 있는 스레드가 있는 프로젝트는 유지됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最近的对话闲置超过这段时间后自动搁置项目。有对话正在运行、未读或已打开的项目不会被搁置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "當專案的最新對話閒置超過這段時間後自動擱置。仍有執行中、未讀或已開啟對話的專案會維持不變。"
          }
        }
      }
    },
    "Shelve a project after its latest thread has been idle this long. Projects with running, unread or selected threads stay put." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Met un projet de côté lorsque sa dernière conversation reste inactive pendant cette durée. Les projets ayant des conversations actives, non lues ou actuellement sélectionnées restent en place."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最新のスレッドがこの期間アイドル状態になるとプロジェクトを一時退避します。実行中、未読、または現在選択中のスレッドがあるプロジェクトはそのまま維持されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가장 최근 스레드가 이 기간 동안 유휴 상태이면 프로젝트를 보관합니다. 실행 중이거나 읽지 않았거나 현재 선택된 스레드가 있는 프로젝트는 유지됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "项目内最近的对话闲置超过此时间后自动搁置项目。若项目中有正在运行、未读或当前选中的对话，则不会被搁置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "當專案的最新對話閒置超過這段時間後自動擱置。仍有執行中、未讀或目前選取對話的專案會維持不變。"
          }
        }
      }
    },

    "Automatically archive sub-agent sessions that finish successfully, and restore them when you need to continue. This only affects Codex's local history; it does not clean up existing records or delete sessions." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Archive automatiquement les sessions de sous-agents terminées avec succès et les restaure lorsque vous devez continuer. Cela n’affecte que l’historique local de Codex, sans nettoyer les entrées existantes ni supprimer de sessions."
          }
        },
        "ja" : {
          "stringUnit" : {

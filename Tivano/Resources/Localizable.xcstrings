    "Deletes node_modules and other dependency and build folders. Your code and changes stay; the next install or build brings them back." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprime node_modules ainsi que les autres dossiers de dépendances et de compilation. Votre code et vos modifications restent intacts ; ils seront recréés lors de la prochaine installation ou compilation."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "node_modules などの依存関係やビルドフォルダーを削除します。コードや変更内容はそのまま残り、次回のインストールまたはビルド時に再生成されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "node_modules 및 기타 의존성과 빌드 폴더를 삭제합니다. 코드와 변경 사항은 그대로 유지되며 다음 설치 또는 빌드 시 다시 생성됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "删除 node_modules 等依赖和构建文件夹。你的代码和改动都不受影响，下次安装或构建时会重新生成。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "刪除 node_modules 及其他相依套件與建置資料夾。你的程式碼與變更會保留，下次安裝或建置時會重新產生。"
          }
        }
      }
    },
    "Deletes only eligible older diagnostic reports and rotated logs. Keeps the latest hang report and current logs. Chats, attachments, worktrees and recovery data are not removed." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprime uniquement les anciens rapports de diagnostic et journaux archivés éligibles. Conserve le dernier rapport de blocage et les journaux actuels. Les discussions, pièces jointes, worktrees et données de récupération ne sont pas supprimés."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "対象となる古い診断レポートとローテーション済みログのみを削除します。最新のハングレポートと現在のログは保持されます。チャット、添付ファイル、worktree、復旧データは削除されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "정리 대상인 오래된 진단 보고서와 순환된 로그만 삭제합니다. 최신 응답 없음 보고서와 현재 로그는 유지됩니다. 채팅, 첨부 파일, worktree 및 복구 데이터는 삭제되지 않습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅删除符合清理条件的旧诊断报告和已轮转日志，保留最新卡顿报告和当前日志。不会删除对话、附件、worktree 或恢复数据。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "僅刪除符合清理條件的舊診斷報告與已輪替日誌，保留最新的無回應報告與目前日誌。不會移除對話、附件、worktree 或復原資料。"
          }
        }
      }
    },
    "Deletes only obsolete update files that are no longer in use. Keeps files used by downloads, pending installations and rollback. Chats, attachments, worktrees and recovery data are not removed." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprime uniquement les fichiers de mise à jour obsolètes qui ne sont plus utilisés. Conserve les fichiers utilisés pour les téléchargements, les installations en attente et la restauration. Les discussions, pièces jointes, worktrees et données de récupération ne sont pas supprimés."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用されなくなった古いアップデートファイルのみを削除します。ダウンロード中、インストール待ち、ロールバック用のファイルは保持されます。チャット、添付ファイル、worktree、復旧データは削除されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "더 이상 사용되지 않는 오래된 업데이트 파일만 삭제합니다. 다운로드, 설치 대기 및 롤백에 사용되는 파일은 유지됩니다. 채팅, 첨부 파일, worktree 및 복구 데이터는 삭제되지 않습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅删除已不再使用的过期更新文件，保留下载、待安装及回滚使用的文件。不会删除对话、附件、worktree 或恢复数据。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "僅刪除已不再使用的過時更新檔案，保留下載中、待安裝及回溯使用的檔案。不會移除對話、附件、worktree 或復原資料。"
          }
        }
      }
    },
    "Deletes this whole copy. Its branch and commits stay in the repository." : {
      "extractionState" : "manual",

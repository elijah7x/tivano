    "Right-click the sub-agent button in a chat to switch sub-agents off or on for that chat." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites un clic droit sur le bouton des sous-agents dans une conversation pour activer ou désactiver les sous-agents pour celle-ci."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "チャット内のサブエージェントボタンを右クリックすると、そのチャットでサブエージェントのオン／オフを切り替えられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대화에서 하위 에이전트 버튼을 오른쪽 클릭해 해당 대화의 하위 에이전트를 켜거나 끌 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在对话中右键点击子代理按钮，可为该对话关闭或开启子代理。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在對話中對子代理按鈕按右鍵，即可為該對話關閉或開啟子代理。"
          }
        }
      }
    },

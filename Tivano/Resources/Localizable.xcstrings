        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "전체 %lld개 대화의 기록이 삭제됩니다. 프로젝트 내 파일은 그대로 유지됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {

        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此對話使用的 Claude 帳號無法使用，請恢復該帳號後繼續。"
          }
        }
      }
    },
    "This chat's history couldn't be read. Tivano kept the files in %@." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’historique de cette discussion n’a pas pu être lu. Tivano a conservé les fichiers dans %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このチャットの履歴を読み込めませんでした。Tivano はファイルを %@ に保持しています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 대화의 기록을 읽을 수 없습니다. Tivano가 파일을 %@ 경로에 보관했습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {

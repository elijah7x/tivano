    "Writes thread titles, commit messages and composer predictions. Fast, inexpensive models are usually enough." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rédige les titres de conversation, les messages de commit et les suggestions de saisie. Des modèles rapides et économiques suffisent généralement."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スレッドのタイトル、コミットメッセージ、入力欄の予測を生成します。高速で低コストなモデルで通常は十分です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "스레드 제목, 커밋 메시지, 입력창 예측을 작성합니다. 빠르고 저렴한 모델이면 보통 충분합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用于生成对话标题、提交信息和输入框预测。快速、便宜的模型通常就够用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用於產生對話標題、提交訊息與輸入框預測。快速、經濟的模型通常就已足夠。"
          }
        }
      }
    },

    },
    "%@'s unfinished work was kept as a recovery patch.\n%@\n\nIts copy is then removed. Review the patch against your checkout before applying it with `git apply --3way %@`." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le travail inachevé de %@ a été conservé en tant que correctif de récupération.\n%@\n\nSa copie est ensuite supprimée. Vérifiez le correctif par rapport à votre copie de travail avant de l’appliquer avec `git apply --3way %@`."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ の未完了の作業はリカバリパッチとして保存されました。\n%@\n\n作業コピーは削除されます。`git apply --3way %@` で適用する前に、チェックアウトと照らし合わせてパッチを確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@의 미완료 작업이 복구 패치로 저장되었습니다.\n%@\n\n이후 작업 사본은 삭제됩니다. `git apply --3way %@` 명령으로 적용하기 전에 체크아웃 상태와 패치 내용을 검토하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 尚未完成的工作已保存为恢复补丁。\n%@\n\n其副本已移除。请先对照检出目录检查补丁，再使用 `git apply --3way %@` 应用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 尚未完成的工作已保留為復原修補檔。\n%@\n\n其工作複本隨即移除。請先對照檢出目錄檢查修補檔，再使用 `git apply --3way %@` 套用。"
          }
        }
      }
    },
    "%@'s work did not land and was kept as a patch.\n%@\n\n%@Apply it with `git apply --3way %@` and settle what conflicts." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le travail de %@ n’a pas été intégré et a été conservé sous forme de correctif.\n%@\n\n%@Appliquez-le avec `git apply --3way %@` et résolvez les conflits éventuels."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ の作業は統合されず、パッチとして保存されました。\n%@\n\n%@`git apply --3way %@` で適用し、競合を解消してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@의 작업이 반영되지 않아 패치로 저장되었습니다.\n%@\n\n%@`git apply --3way %@` 명령으로 적용한 뒤 충돌을 해결하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 的工作没有落地，已保存为补丁。\n%@\n\n%@用 `git apply --3way %@` 应用它，并处理冲突。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 的工作尚未合併，已保留為修補檔。\n%@\n\n%@請使用 `git apply --3way %@` 套用並解決衝突。"
          }
        }
      }
    },
    "%@'s work landed; the lead is settling a conflict in %d files.\n%@\n\nThe checkout had moved on where %@ was working, so the merge was three-way and left markers in these files. The lead resolves them before the work goes out; nothing to do on your side." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le travail de %@ a été intégré ; l’agent principal résout un conflit dans %d fichiers.\n%@\n\nLa copie de travail ayant avancé pendant l’intervention de %@, une fusion à trois voies a laissé des marqueurs dans ces fichiers. L’agent principal les résoudra avant la livraison ; aucune action n’est requise de votre part."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ の作業を取り込みました。リードエージェントが %d 個のファイルの競合を解消しています。\n%@\n\n%@ の作業中にチェックアウト先が進んでいたため、3方向マージが実行され、これらのファイルにマーカーが残りました。結果を反映する前にリードが解消するため、操作は不要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@의 작업이 반영되었습니다. 리드 에이전트가 %d개 파일의 충돌을 해결하고 있습니다.\n%@\n\n%@ 작업 중 체크아웃 상태가 변경되어 3방향 병합이 수행되었고 이 파일들에 마커가 남았습니다. 리드가 결과를 내보내기 전에 해결하므로 별도 조치는 필요하지 않습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 的工作已落地；主代理正在处理 %d 个文件里的冲突。\n%@\n\n%@ 工作时检出目录已经往前走了，所以这次合并是三方合并，在这些文件里留下了标记。主代理会在工作成果发出前解决它们，你这边无需操作。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 的工作已合併；主代理正在處理 %d 個檔案中的衝突。\n%@\n\n%@ 工作期間檢出目錄已有新進度，因此本次採用三方合併，並在這些檔案中留下衝突標記。主代理會在結果送出前解決衝突，你無須進行任何操作。"
          }
        }
      }
    },
    "%@'s work landed; the lead is settling a conflict in 1 file.\n%@\n\nThe checkout had moved on where %@ was working, so the merge was three-way and left markers in this file. The lead resolves them before the work goes out; nothing to do on your side." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le travail de %@ a été intégré ; l’agent principal résout un conflit dans 1 fichier.\n%@\n\nLa copie de travail ayant avancé pendant l’intervention de %@, une fusion à trois voies a laissé des marqueurs dans ce fichier. L’agent principal les résoudra avant la livraison ; aucune action n’est requise de votre part."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ の作業を取り込みました。リードエージェントが 1 個のファイルの競合を解消しています。\n%@\n\n%@ の作業中にチェックアウト先が進んでいたため、3方向マージが実行され、このファイルにマーカーが残りました。結果を反映する前にリードが解消するため、操作は不要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@의 작업이 반영되었습니다. 리드 에이전트가 1개 파일의 충돌을 해결하고 있습니다.\n%@\n\n%@ 작업 중 체크아웃 상태가 변경되어 3방향 병합이 수행되었고 이 파일에 마커가 남았습니다. 리드가 결과를 내보내기 전에 해결하므로 별도 조치는 필요하지 않습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 的工作已落地；主代理正在处理 1 个文件里的冲突。\n%@\n\n%@ 工作时检出目录已经往前走了，所以这次合并是三方合并，在这个文件里留下了标记。主代理会在工作成果发出前解决它们，你这边无需操作。"
          }
        },
        "zh-Hant" : {

    },
    "%@ Retrying." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 正在重试。"
          }
        }
      }
    },
    "%@ The install channel is unknown, so Tivano will not update it." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 安装渠道未知，Tivano 不会代为更新。"
          }

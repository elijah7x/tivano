    "As threads of their own, asked for at the end of the lead's reply." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dans des conversations distinctes, demandées à la fin de la réponse de l’agent principal."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "独立したスレッドとして、リードエージェントの応答の最後に実行します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "독립된 스레드로 실행되며, 리드 에이전트의 답변이 끝날 때 요청됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "作为独立对话运行，在主代理回复结束时发起。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "作為獨立對話執行，並在主代理回覆結束時發起。"
          }
        }
      }
    },
    "Ask %@ for anything; the lead decides what to do itself and what to delegate" : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",

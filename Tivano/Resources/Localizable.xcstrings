    "%@ could not reach the network after %lld attempts. Check the connection, then try again." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ n’a pas pu joindre le réseau après %lld tentatives. Vérifiez la connexion, puis réessayez."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",

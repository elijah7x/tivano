    "%@ paused after %lld rounds of tool calls in one turn. Say “continue” to pick up where it left off." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ s’est mis en pause après %lld séries d’appels d’outils en un tour. Dites « continuer » pour reprendre."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ は 1 ターン内でツール呼び出しを %lld ラウンド行ったため一時停止しました。再開するには「続行」と入力してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@에서 한 턴에 %lld라운드 연속 도구를 호출한 뒤 일시 중지했습니다. 이어서 진행하려면 “계속”을 입력하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 一轮内连续调用了 %lld 轮工具后暂停。回复“继续”，它就会接着做。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 在單一回合內連續呼叫 %lld 輪工具後已暫停。回覆「繼續」即可接續先前進度。"
          }
        }
      }
    },

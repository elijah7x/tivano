          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DeepSeek Harness"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DeepSeek Harness"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DeepSeek Harness"
          }
        }
      }
    },
    "DeepSeek Harness %1$@ has no ACP row %2$@, which %3$@ changes. Update Tivano, or remove that entry from the patch." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DeepSeek Harness %1$@ ne contient pas la ligne ACP %2$@, modifiée par %3$@. Mettez à jour Tivano ou supprimez cette entrée du correctif."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DeepSeek Harness %1$@ には %3$@ が変更する ACP 行 %2$@ がありません。Tivano をアップデートするか、パッチからその項目を削除してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%3$@에서 변경하는 ACP 항목(%2$@)이 DeepSeek Harness %1$@에 없습니다. Tivano를 업데이트하거나 패치에서 해당 항목을 제거하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DeepSeek Harness %1$@ 中没有 ACP 配置项 %2$@，但 %3$@ 要修改它。请更新 Tivano，或从该补丁中删除这一项。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DeepSeek Harness %1$@ 沒有 %3$@ 所修改的 ACP 項目 %2$@。請更新 Tivano，或從修補程式中移除該項目。"
          }
        }
      }
    },
    "DeepSeek Harness %@ changed what Tivano reads to load your desktop profile, so chats on it run without the profile's plugins until Tivano catches up." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DeepSeek Harness %@ a modifié la structure utilisée par Tivano pour charger votre profil de bureau ; les discussions sur cette version s’exécuteront donc sans les plugins du profil jusqu’à la mise à jour de Tivano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DeepSeek Harness %@ でデスクトッププロファイルの読み込み仕様が変更されたため、Tivano が対応するまで、このバージョンでのチャットはプロファイルのプラグインなしで実行されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DeepSeek Harness %@ 버전에서 Tivano가 데스크톱 프로필을 불러오는 구조가 변경되어, Tivano가 지원할 때까지 이 버전의 채팅은 프로필의 플러그인 없이 실행됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DeepSeek Harness %@ 调整了 Tivano 加载桌面配置所依赖的内部结构，在 Tivano 适配前，该版本的对话将不加载桌面配置中的插件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DeepSeek Harness %@ 變更了 Tivano 載入桌面設定檔時讀取的結構，在 Tivano 支援此版本前，該版本的對話將不載入設定檔中的外掛程式。"
          }
        }
      }
    },
    "DeepSeek Harness %@ is newer or older than the %@ Tivano supports, so desktop profiles are off for this chat." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DeepSeek Harness %1$@ est plus récent ou plus ancien que la version %2$@ prise en charge par Tivano ; les profils de bureau sont donc désactivés pour cette discussion."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DeepSeek Harness %1$@ は Tivano がサポートする %2$@ より新しいか古いため、このチャットではデスクトッププロファイルが無効になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DeepSeek Harness %1$@ 버전이 Tivano가 지원하는 %2$@ 버전과 달라 이 채팅에서는 데스크톱 프로필이 비활성화됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DeepSeek Harness %@ 与 Tivano 支持的 %@ 版本不一致，本次对话不启用桌面配置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DeepSeek Harness %1$@ 與 Tivano 所支援的 %2$@ 版本不一致，本次對話已停用桌面設定檔。"
          }
        }
      }
    },
    "DeepSeek Harness account sign-in failed. Try again." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Échec de la connexion au compte DeepSeek Harness. Réessayez."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DeepSeek Harness アカウントへのサインインに失敗しました。やり直してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DeepSeek Harness 계정 로그인에 실패했습니다. 다시 시도하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DeepSeek Harness 账号登录失败，请重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DeepSeek Harness 帳號登入失敗，請再試一次。"
          }
        }
      }
    },
    "DeepSeek Harness at %@ cannot inherit the desktop app's marketplace profile, and retrying will fail the same way. Use the CLI bundled with the DeepSeek Harness app, or set it as the Binary path in Settings › Provider management › DeepSeek Harness." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le binaire DeepSeek Harness situé dans %@ ne peut pas hériter du profil du marketplace de l’app de bureau, et toute nouvelle tentative échouera de la même manière. Utilisez la CLI fournie avec l’app DeepSeek Harness ou définissez-la comme chemin du binaire dans Réglages › Gestion des fournisseurs › DeepSeek Harness."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ の DeepSeek Harness はデスクトップアプリのマーケットプレイスプロファイルを継承できず、再試行しても同様に失敗します。DeepSeek Harness アプリに同梱されている CLI を使用するか、「設定」›「プロバイダー管理」›「DeepSeek Harness」で実行ファイルのパスに設定してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 경로의 DeepSeek Harness는 데스크톱 앱의 마켓플레이스 프로필을 상속할 수 없으며, 다시 시도해도 동일하게 실패합니다. DeepSeek Harness 앱에 번들로 포함된 CLI를 사용하거나 '설정 › 제공자 관리 › DeepSeek Harness'에서 실행 파일 경로로 지정하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位于 %@ 的 DeepSeek Harness 无法继承桌面应用的市场配置，重试也会以同样方式失败。请使用 DeepSeek Harness 应用自带的 CLI，或在“设置 › 服务商配置 › DeepSeek Harness”中将其设为可执行文件路径。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位於 %@ 的 DeepSeek Harness 無法繼承桌面應用程式的市集設定檔，重試仍會發生相同錯誤。請使用 DeepSeek Harness 應用程式隨附的 CLI，或在「設定 › 供應商管理 › DeepSeek Harness」中將其設為執行檔路徑。"
          }
        }
      }
    },

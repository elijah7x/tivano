      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "主智能体倾向于把能用独立任务说明交代清楚的工作交给 heads，包括范围明确的单项修改，并拆分较大的工作以便并行执行。主智能体保留判断、跨文件设计、整合，以及细小或需要谨慎处理的部分。"
          }
        }
      }

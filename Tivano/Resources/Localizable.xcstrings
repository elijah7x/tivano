    "The histories of all %lld chats will be removed. Files in your projects stay as they are." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’historique des %lld conversations sera supprimé. Les fichiers de vos projets resteront inchangés."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "全 %lld 件のチャットの履歴が削除されます。プロジェクト内のファイルはそのまま残ります。"

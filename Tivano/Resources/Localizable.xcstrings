{
  "sourceLanguage" : "en",
  "strings" : {
    "A branch with that name already exists." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已存在同名分支。"
          }
        }
      }
    },
    "A relaunch would drop a usage-limit wait. Stop the wait from that chat's box to update now." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重启会取消等待额度重置的自动继续。如需立即更新，请在该对话的输入框中停止等待。"
          }
        }
      }
    },
    "An external control request is in progress" : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "外部控制请求处理中"
          }
        }
      }
    },
    "And %lld more" : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "还有 %lld 个"
          }
        }
      }
    },
    "Branch names can be up to %lld characters." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "分支名称最多 %lld 个字符。"
          }
        }
      }
    },
    "Branch names can use letters, numbers and - _ . / only." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "分支名称只能包含字母、数字和 - _ . /。"
          }
        }
      }
    },
    "Could not rename branch" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法重命名分支"
          }
        }
      }
    },
    "DeepSeek Harness %@ changed what Tivano reads to load your desktop profile, so chats on it run without the profile's plugins until Tivano catches up." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DeepSeek Harness %@ 调整了 Tivano 加载桌面配置所依赖的内部结构，在 Tivano 适配前，该版本的对话将不加载桌面配置中的插件。"
          }
        }
      }
    },
    "DeepSeek Harness %@ is newer or older than the %@ Tivano supports, so desktop profiles are off for this chat." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DeepSeek Harness %@ 与 Tivano 支持的 %@ 版本不一致，本次对话不启用桌面配置。"
          }
        }
      }
    },
    "DeepSeek Harness at %@ cannot inherit the desktop app's marketplace profile, and retrying will fail the same way. Use the CLI bundled with the DeepSeek Harness app, or set it as the Binary path in Settings → Providers → DeepSeek Harness." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位于 %@ 的 DeepSeek Harness 无法继承桌面应用的市场配置，重试也会以同样方式失败。请使用 DeepSeek Harness 应用自带的 CLI，或在“设置 → 服务商 → DeepSeek Harness”中将其设为可执行文件路径。"
          }
        }
      }
    },
    "Finish or abort the merge, rebase or cherry-pick in progress, then rename the branch." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请先完成或中止正在进行的合并、变基或拣选，再重命名分支。"
          }
        }
      }
    },
    "Its helpers or heads are still working" : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "子智能体仍在工作"
          }
        }
      }
    },
    "Landing Hydra work" : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正在合入 Hydra 工作"
          }

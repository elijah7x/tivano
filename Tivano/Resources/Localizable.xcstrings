          "stringUnit" : {
            "state" : "translated",
            "value" : "允許 %@ 控制 Tivano 嗎？"
          }
        }
      }
    },
    "Allow Tivano to use the microphone in System Settings › Privacy & Security › Microphone." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorisez Tivano à utiliser le microphone dans Réglages Système › Confidentialité et sécurité › Microphone."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「システム設定」›「プライバシーとセキュリティ」›「マイク」で、Tivano にマイクの使用を許可してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시스템 설정 › 개인정보 보호 및 보안 › 마이크에서 Tivano의 마이크 사용을 허용하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请在“系统设置 › 隐私与安全性 › 麦克风”中允许 Tivano 使用麦克风。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請在「系統設定 › 隱私權與安全性 › 麥克風」中允許 Tivano 使用麥克風。"
          }
        }
      }
    },

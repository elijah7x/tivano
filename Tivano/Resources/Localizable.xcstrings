          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%d 個のファイルがすべてのプロジェクト外で変更されました：%@。それらのファイルを含むフォルダーをサイドバーに追加してから、もう一度マージを依頼してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "프로젝트 외부에서 파일 %d개가 변경되었습니다: %@. 해당 파일이 들어 있는 폴더를 사이드바에 추가한 뒤 다시 병합을 요청하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",

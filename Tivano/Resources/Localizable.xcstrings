    "Archived sessions keep their IDs and can be resumed. Archiving does not affect Tivano's sidebar or history on provider websites." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les sessions archivées conservent leur identifiant et peuvent être reprises. L’archivage n’affecte ni la barre latérale de Tivano ni l’historique sur les sites des fournisseurs."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アーカイブされたセッションは元の ID を保持し、再開できます。アーカイブしても、Tivano のサイドバーやプロバイダーの Web サイト上の履歴には影響しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "보관된 세션은 기존 ID를 유지하며 다시 이어서 진행할 수 있습니다. 보관하더라도 Tivano 사이드바나 제공자 웹사이트의 기록에는 영향을 주지 않습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "归档后的会话保留原 ID，可恢复并继续。归档不影响 Tivano 侧边栏或服务商网站上的历史记录。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "封存後的工作階段會保留原 ID，且可恢復並繼續使用。封存不會影響 Tivano 側邊欄或供應商網站上的歷史紀錄。"
          }
        }
      }
    },
    "Archived threads cannot be controlled externally." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les conversations archivées ne peuvent pas être contrôlées depuis l’extérieur."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アーカイブ済みのスレッドは外部から制御できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "보관된 스레드는 외부에서 제어할 수 없습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法通过外部控制操作已归档的对话。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法透過外部控制操作已封存的對話。"
          }
        }
      }
    },
    "Archives the selected thread without asking for confirmation." : {

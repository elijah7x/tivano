    },
    "For new delegated Tivano-run Codex heads after successful completion. Archived sessions keep their IDs and resume on the next message. Lead chats, older sessions and heads with user follow-ups stay visible." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "适用于由 Tivano 运行、新委派的 Codex 子智能体，在成功完成之后生效。已归档的会话保留其 ID，并在下一条消息时恢复。主导对话、较早的会话，以及收到用户后续消息的子智能体仍保持可见。"
          }
        }
      }
    },

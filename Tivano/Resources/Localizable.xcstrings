    "Kimi Code asked a question in a form Tivano cannot display. The request was declined." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kimi Code a posé une question sous une forme que Tivano ne peut pas afficher. La demande a été refusée."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kimi Code が Tivano で表示できない形式で質問したため、リクエストは拒否されました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kimi Code가 Tivano에서 표시할 수 없는 형식으로 질문하여 요청을 거절했습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kimi Code 提问所用的表单暂不受 Tivano 支持，已拒绝该请求。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kimi Code 使用了 Tivano 無法顯示的表單提問，已拒絕該請求。"
          }
        }
      }
    },
    "Kimi Code did not advertise the requested permission or interaction mode. Choose a supported mode and try again." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kimi Code n’a pas annoncé le mode d’autorisation ou d’interaction demandé. Choisissez un mode pris en charge et réessayez."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",

      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifie les mises à jour des CLI installées toutes les six heures. L’installation ne démarre que lorsque vous choisissez Mettre à jour."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "インストール済みの CLI のアップデートを 6 時間ごとに確認します。「アップデート」を選択した場合のみインストールが開始されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설치된 CLI의 업데이트를 6시간마다 확인합니다. '업데이트'를 선택해야 설치가 시작됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每六小时检查已安装 CLI 的更新；仅在你点击“更新”后安装。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每六小時檢查已安裝 CLI 的更新；僅在選擇「更新」後才會開始安裝。"
          }
        }
      }
    },

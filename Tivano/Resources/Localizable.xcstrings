    },
    "This client or its return address is not registered with Tivano." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce client ou son adresse de retour n’est pas enregistré auprès de Tivano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このクライアントまたはその戻り先アドレスは Tivano に登録されていません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 클라이언트 또는 반환 주소가 Tivano에 등록되어 있지 않습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",

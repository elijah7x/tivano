    "Antigravity held back %@ waiting for a permission it could not ask for. Use Full access for this chat." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antigravity a retenu %@ en attente d’une autorisation qu’il ne pouvait pas demander. Activez l’accès complet pour cette discussion."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antigravity は確認できないアクセス権を待機して %@ を保留しました。このチャットでは「フルアクセス」を使用してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antigravity가 요청할 수 없는 권한을 기다리느라 %@ 작업을 보류했습니다. 이 대화에는 전체 접근 권한을 사용하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antigravity 拦下了 %@，等待一个它无法询问的权限。请为此对话开启完全访问。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antigravity 暫緩了 %@，因無法請求所需的權限。請為此對話開啟「完整存取權限」。"
          }
        }
      }
    },

          }
        }
      }
    },
    "%@ couldn't pick this conversation back up (%@). It starts a new one here, without the messages above." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ n’a pas pu reprendre cette conversation (%@). Une nouvelle commence ici, sans les messages précédents."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ はこのスレッドを再開できませんでした（%@）。上のメッセージを引き継がず、ここから新しいスレッドを開始します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@에서 이 대화를 이어가지 못했습니다(%@). 위 메시지는 제외하고 여기에서 새 대화를 시작합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 无法恢复此对话（%@）。将在此开始新对话，不包含上面的消息。"

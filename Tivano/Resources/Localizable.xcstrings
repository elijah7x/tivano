          }
        }
      }
    },
    "You review changes before merge. Read only, edit nothing. List real bugs by severity with file and line." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",

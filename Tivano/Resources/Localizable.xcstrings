        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude 对话用 %1$@，其他对话用 %2$@（低推理强度）。用于对话标题、提交信息和输入框预测。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",

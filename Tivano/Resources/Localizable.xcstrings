  },
  "The update command finished, but the version went from %1$@ to %2$@.": {
    "extractionState": "manual",
    "localizations": {
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "更新命令已结束，但版本从 %1$@ 退回到 %2$@。"
        }
      }
    }
  },
  "The update command finished at %1$@, which is older than %2$@.": {
    "extractionState": "manual",
    "localizations": {
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "更新命令结束于 %1$@，低于目标版本 %2$@。"
        }
      }
    }
  },
  "The CLI was updated, but the provider status could not be refreshed.": {
    "extractionState": "manual",

    "Codex could not carry this chat's history to the other account. Start a new chat to continue there." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Codex n’a pas pu transférer l’historique de cette discussion vers l’autre compte. Démarrez une nouvelle discussion pour continuer là-bas."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Codex はこのチャットの履歴を別のアカウントに引き継げませんでした。そちらで新しいチャットを開始して続行してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Codex가 이 대화의 기록을 다른 계정으로 가져갈 수 없습니다. 해당 계정에서 새 대화를 시작하여 계속하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Codex 无法把这段对话的历史带到另一个账号，请新开对话继续。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Codex 無法將這段對話的歷史紀錄帶到另一個帳號。請在該帳號開啟新對話以繼續。"
          }
        }
      }
    },

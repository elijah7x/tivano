    "%@ is available." : {
      "extractionState": "manual",
      "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "%@ 可用。" } } }
    },
    "%@ is available. A custom binary path is set, so Tivano will not update it." : {
      "extractionState": "manual",
      "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "%@ 可用。已设置自定义可执行文件路径，因此 Tivano 不会更新它。" } } }
    },
    "%@ is available. Its install channel is unknown, so update it the way it was installed." : {
      "extractionState": "manual",
      "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "%@ 可用。安装渠道未知，请按当初的安装方式自行更新。" } } }
    },
    "A custom binary path is set, so Tivano will not update it." : {
      "extractionState": "manual",
      "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "已设置自定义可执行文件路径，因此 Tivano 不会更新它。" } } }
    },
    "A custom binary path is set, so Tivano will not update it. It still compares the installed version with the newest release every six hours." : {
      "extractionState": "manual",
      "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "已设置自定义可执行文件路径，因此 Tivano 不会更新它。仍会每六小时将已安装版本与最新发布版比较一次。" } } }
    },
    "An update is available." : {
      "extractionState": "manual",
      "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "有可用更新。" } } }
    },
    "An update is available. A custom binary path is set, so Tivano will not update it." : {
      "extractionState": "manual",
      "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "有可用更新。已设置自定义可执行文件路径，因此 Tivano 不会更新它。" } } }
    },
    "An update is available. Its install channel is unknown, so update it the way it was installed." : {
      "extractionState": "manual",
      "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "有可用更新。安装渠道未知，请按当初的安装方式自行更新。" } } }
    },
    "Check for updates" : {
      "extractionState": "manual",

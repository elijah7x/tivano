    "Never deleted: chats, attachments, code and uncommitted changes in worktrees, branches and commits, recovery patches." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jamais supprimés : discussions, pièces jointes, code et modifications non validées dans les worktrees, branches et commits, correctifs de récupération."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "削除されないもの：チャット、添付ファイル、worktree 内のコードや未コミットの変更、ブランチとコミット、リカバリパッチ。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "삭제되지 않는 항목: 대화, 첨부 파일, worktree의 코드와 커밋되지 않은 변경 사항, 브랜치 및 커밋, 복구 패치."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "绝不删除：对话、附件、worktree 中的代码和未提交的改动、分支和提交、恢复补丁。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "絕不刪除：對話、附件、worktree 中的程式碼與未提交的變更、分支與提交、復原修補程式。"
          }
        }
      }
    },

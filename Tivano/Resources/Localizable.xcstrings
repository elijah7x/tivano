    "Start the connection again from your agent." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请从代理重新发起连接。"
          }
        }
      }
    },
    "This client or its return address is not registered with Tivano." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此客户端或其返回地址未在 Tivano 中注册。"
          }
        }
      }
    },
    "This page refreshes by itself. You can close it after your agent says it is connected." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此页面会自动刷新。代理提示已连接后，你可以关闭此页面。"
          }
        }
      }
    },
    "Threads that cloud agents create start in Full access: commands and file changes run without asking. Threads created while this is off, and your own threads, keep their permissions. Questions still wait in Tivano." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "云端代理新建的对话以“完全访问”权限启动：命令和文件修改无需询问即可执行。关闭此项期间创建的对话以及你自己的对话保持原有权限。问题仍需你在 Tivano 中回答。"
          }
        }
      }
    },
    "Tivano is waiting for you to approve %@ on your Mac. Check that Tivano shows this code:" : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tivano 正在等待你在 Mac 上批准 %@。请确认 Tivano 显示以下验证码："
          }
        }
      }
    },
    "Too many requests waiting" : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "等待中的请求过多"
          }
        }
      }
    },

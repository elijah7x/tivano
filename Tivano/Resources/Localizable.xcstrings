            "value" : "Tivano ライブラリ"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tivano 라이브러리"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {

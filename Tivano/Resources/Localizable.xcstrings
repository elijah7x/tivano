          }
        }
      }
    },
    "The lower of this limit and the combo's limit applies. No cap adds no limit here." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La limite la plus basse entre celle-ci et celle de la combinaison s’applique. « Illimité » n’ajoute aucune limite ici."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この上限とコンボの上限のうち小さい方が適用されます。「上限なし」ではここで制限を加えません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 제한과 콤보의 제한 중 더 낮은 값이 적용됩니다. '제한 없음'은 추가 제한을 두지 않습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此处与模型搭配中较小的上限生效。“不限”表示此处不额外限制。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此上限與模型搭配上限兩者取較小值生效。「無上限」表示此處不額外限制。"
          }
        }
      }
    },

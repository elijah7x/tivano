    "Where your key was issued. Global uses api.z.ai, China uses open.bigmodel.cn." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Site d’émission de votre clé. La version internationale utilise api.z.ai et la version Chine open.bigmodel.cn."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キーが発行されたリージョンです。グローバル版では api.z.ai、中国版では open.bigmodel.cn を使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "키가 발급된 사이트입니다. 글로벌은 api.z.ai를, 중국은 open.bigmodel.cn을 사용합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {

    },
    "MiniMax Code currently uses text input in Tivano. Image attachments, plan balances and token-spend accounting are not enabled." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MiniMax Code utilise actuellement la saisie de texte dans Tivano. Les pièces jointes d’image, les soldes d’abonnement et le suivi de consommation de tokens ne sont pas activés."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",

          }
        }
      }
    },
    "While a turn runs, lines the draft up behind it." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pendant qu’un tour est en cours, place le brouillon en file d’attente."
          }
        },
        "ja" : {

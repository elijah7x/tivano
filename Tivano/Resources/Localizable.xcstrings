    "Collapsed otherwise; the list button in the toolbar shows and hides it any time" : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réduit le reste du temps ; le bouton de liste dans la barre d’outils permet de l’afficher ou de le masquer à tout moment"
          }
        },
        "ja" : {
          "stringUnit" : {

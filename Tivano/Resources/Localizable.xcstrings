    "Tasks (no project)" : {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任务（不归属项目）"
          }
        }
      }
    },
    "Project Hydra presets take priority. Otherwise, Last selection uses the current or most recent model; a selected model stays fixed." : {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "项目的 Hydra 预设优先；否则，“上一次选择”沿用当前或最近的模型；“指定模型”则固定使用该模型。"
          }
        }
      }
    },
    "By default, follow the latest chat's location, including Tasks. Applies only to ordinary new chats; creating a chat from a project still places it in that project." : {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认跟随最近会话所在位置，包括任务。此设置仅影响普通新建；从项目中明确新建的会话仍归属该项目。"
          }
        }
      }
    },
    "%@ (unavailable)" : {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@（不可用）"

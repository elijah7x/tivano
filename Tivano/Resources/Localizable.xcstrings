{
  "sourceLanguage" : "en",
  "strings" : {
    "Hydra: no project named %@ is in the sidebar, so %@ did not start.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Hydra：侧栏中没有名为 %@ 的项目，因此 %@ 未启动。"
          }
        }
      }
    },
    "Hydra: %@ is not a folder on this Mac, so %@ did not start.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Hydra：%@ 不是这台 Mac 上的文件夹，因此 %@ 未启动。"
          }
        }
      }
    },
    "Hydra: %@ is not a Git checkout Tivano can read, so %@ did not start.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Hydra：%@ 不是 Tivano 可读取的 Git checkout，因此 %@ 未启动。"
          }
        }
      }
    },
    "Hydra: %@ did not start because its checkout could not be read.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Hydra：无法读取 %@ 的 checkout，因此未启动。"
          }
        }
      }
    },
    "MCP configuration could not be loaded": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法加载 MCP 配置"
          }
        }
      }
    },
    "MCP changes are paused": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "MCP 修改已暂停"
          }
        }
      }
    },
    "Your files and credentials are unchanged. Repair the configuration file, then retry.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件和凭证未被修改。请修复配置文件后重试。"
          }
        }
      }
    },
    "Configuration file": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配置文件"
          }
        }
      }
    },
    "Could not read MCP configuration at %@.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取 %@ 中的 MCP 配置。"
          }
        }
      }
    },
    "Invalid MCP configuration at %@.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 中的 MCP 配置无效。"
          }
        }
      }
    },
    "MCP configuration could not be loaded. Repair the file and retry in Settings before making changes.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法加载 MCP 配置。请修复文件并在设置中重试后再修改。"
          }
        }
      }
    },
    "Retry": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重试"
          }
        }
      }
    },
    "That path is outside the project. Stay inside %@.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该路径位于项目之外。请限定在 %@ 内。"
          }
        }
      }
    },
    "A file path must not contain a null character.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件路径不能包含空字符。"
          }
        }
      }
    },
    "That path is not a regular file.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该路径不是普通文件。"
          }
        }
      }
    },
    "A search pattern must not contain a null character.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "搜索模式不能包含空字符。"
          }
        }
      }
    },
    "That search regular expression is invalid.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该搜索正则表达式无效。"
          }
        }
      }
    },
    "Search failed.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "搜索失败。"
          }
        }
      }
    },
    "Library could not be loaded": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法加载资料库"
          }
        }
      }
    },
    "Tivano couldn't read its library (%@). The original file and chat documents are preserved. Repair the library and restart Tivano. Any new chats will be saved separately to %@ when you quit.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Tivano 无法读取资料库（%@）。原文件和会话文档已保留。请修复资料库后重启 Tivano。退出时，新建会话会另存至 %@。"
          }
        }
      }
    },
    "Could not save the library": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法保存资料库"
          }
        }
      }
    },
    "Tivano couldn't save your changes to disk. Your chats are kept in memory and saving will be retried. Free up disk space or check folder permissions before quitting.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Tivano 无法将更改保存到磁盘。会话仍保留在内存中，保存会继续重试。退出前请释放磁盘空间或检查文件夹权限。"
          }
        }
      }
    },
    "Kimi Code did not advertise the requested permission or interaction mode. Choose a supported mode and try again.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Kimi Code 未提供所选的权限或交互模式。请选择支持的模式后重试。"
          }
        }
      }
    },
    "Kimi Code asked a question in a form Tivano cannot display. The request was declined.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Kimi Code 提问所用的表单暂不受 Tivano 支持，已拒绝该请求。"
          }
        }
      }
    },
    "Your answer didn't reach %@. The request may no longer be available, or the provider could not accept the answer. Try again or send a message to carry on.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的回答未能送达 %@。请求可能已失效，或 provider 无法接受该回答。请重试，或发送消息继续。"
          }
        }
      }
    },
    "Waiting for Hydra merges to finish.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "等待 Hydra 合并完成。"
          }
        }
      }
    },
    "The download failed with HTTP %d.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载失败，HTTP 状态码为 %d。"
          }
        }
      }
    },
    "The update could not be downloaded. %@": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法下载更新。%@"
          }
        }
      }
    },
    "Tivano couldn't save your chats. The update was not installed. Resolve the disk error and try again.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Tivano 无法保存会话，更新尚未安装。请解决磁盘错误后重试。"
          }
        }
      }
    },
    "Kimi Code" : {
      "extractionState": "manual",
      "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "Kimi Code" } } }
    },
    "Sign in to Kimi Code with `kimi login`, then try again." : {
      "extractionState": "manual",
      "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "请先运行 `kimi login` 登录 Kimi Code，然后重试。" } } }
    },
    "No verified version source is available for this installation." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "此安装暂无已核实的版本源。" } }
      }
    },
    "Claude update settings could not be read." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无法读取 Claude 更新设置。" } }
      }
    },
  "This model needs a newer %@. Updating it, then sending your message again.": {
    "extractionState": "manual",
    "localizations": {
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "此模型需要较新的 %@。正在更新，随后会重新发送你的消息。"
        }
      }
    }
  },
  "%1$@\n\nTivano could not bring %2$@ up to date. Run `%3$@` in Terminal, then send the message again.": {
    "extractionState": "manual",
    "localizations": {
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "%1$@\n\nTivano 未能将 %2$@ 更新到新版本。请在终端中运行 `%3$@`，然后重新发送该消息。"
        }
      }
    }
  },
  "%1$@\n\nTivano could not bring %2$@ up to date. Install the newer version the way you installed it, then send the message again.": {
    "extractionState": "manual",
    "localizations": {
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "%1$@\n\nTivano 未能将 %2$@ 更新到新版本。请按你当初的安装方式安装较新版本，然后重新发送该消息。"
        }
      }
    }
  },
  "%1$@\n\n%2$@ was updated to %3$@. Send the message again.": {
    "extractionState": "manual",
    "localizations": {
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "%1$@\n\n%2$@ 现已更新（%3$@）。请重新发送该消息。"
        }
      }
    }
  },
  "%1$@ was updated to %2$@, but the message could not be sent again: %3$@ Send it again.": {
    "extractionState": "manual",
    "localizations": {
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "%1$@ 现已更新（%2$@），但该消息未能再次发送：%3$@ 请重新发送。"
        }
      }
    }
  },
  "The installed version could not be read.": {
    "extractionState": "manual",
    "localizations": {
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "无法读取已安装版本。"
        }
      }
    }
  },
  "The versions could not be compared, so the update was not kept as successful.": {
    "extractionState": "manual",
    "localizations": {
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "无法比较版本，因此这次更新未记为成功。"
        }
      }
    }
  },
  "The binary changed before the update ran, so Tivano did not update it.": {
    "extractionState": "manual",
    "localizations": {
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "更新开始前可执行文件已变化，因此 Tivano 没有更新它。"
        }
      }
    }
  },
  "No install channel was found, so Tivano did not update it.": {
    "extractionState": "manual",
    "localizations": {
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "未找到安装渠道，因此 Tivano 没有更新它。"
        }
      }
    }
  },
  "The installed version could not be read, so Tivano did not run the update.": {
    "extractionState": "manual",
    "localizations": {
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "无法读取已安装版本，因此 Tivano 没有运行更新。"
        }

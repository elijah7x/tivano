        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 설명이 리드에게 전달되어 해당하는 작업을 하위 에이전트에게 맡깁니다. 예: 빠름(단순 수정용) 또는 프런트엔드."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",

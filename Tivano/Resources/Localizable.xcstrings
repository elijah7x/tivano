    "Left lets the desktop through a little; right deepens the page tone." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vers la gauche, le bureau transparaît légèrement ; vers la droite, la teinte de la page s’approfondit."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "左に動かすとデスクトップがわずかに透け、右に動かすとページの色調が深まります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "왼쪽으로 옮기면 데스크탑이 살짝 비치고, 오른쪽으로 옮기면 페이지 색조가 깊어집니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "向左可稍稍透出桌面，向右让页面底色更实。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "向左可稍稍透出桌面，向右讓頁面色調更沉。"
          }
        }
      }
    },
